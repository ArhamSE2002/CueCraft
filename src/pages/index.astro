---
import BaseLayout from '../layouts/BaseLayout.astro';
import { InteractiveHeroDemo } from '../components/landing/InteractiveHeroDemo';

const curriculumRows = [
  {
    title: 'Dead-Stop Stun & Momentum Transfer',
    formula: 'v_normal = 0 · 90° Separation',
    summary: 'Eliminate roll before contact so linear energy transfers straight into the object ball.',
    learnHref: '/learn/cue-ball-control',
    playHref: '/play?scenario=cue-ball-control',
  },
  {
    title: 'Screw-Back Draw & Topspin Follow',
    formula: 'F_slip = −μs mg (v − u_roll)',
    summary: '2D surface slip physics generates parabolic draw and follow arcs at any cut angle.',
    learnHref: '/learn/topspin-and-backspin',
    playHref: '/play?scenario=topspin-and-backspin',
  },
  {
    title: 'Running Side, Check Side & Elevated Swerve',
    formula: 'e_yaw · Squirt + Curve',
    summary: 'Control cue squirt, cushion bite angle widening, and steep-butt masse curvature.',
    learnHref: '/learn/side-spin-ballistics',
    playHref: '/play?scenario=side-spin-ballistics',
  },
  {
    title: 'Multi-Cushion Escapes & Border Strength',
    formula: 'Restitution e = 0.56 – 0.93',
    summary: 'Calculate two- and three-rail safety rebounds adjusted for rubber border elasticity.',
    learnHref: '/learn/cushion-rebounds',
    playHref: '/play?scenario=cushion-rebounds',
  },
  {
    title: 'Cut-Induced Throw & Ghost Contact',
    formula: '2R = 52.5 mm Contact Axis',
    summary: 'Line-of-centers geometry paired with tangential throw friction across cut angles.',
    learnHref: '/learn/collision-angles',
    playHref: '/play?scenario=collision-angles',
  },
  {
    title: 'Pace Control & Cloth Nap Resistance',
    formula: 'd = v² / (2 μr g)',
    summary: 'Compare stopping distances across Crucible Worsted, Club Baize, and Heavy Nap wool.',
    learnHref: '/learn/speed-and-distance',
    playHref: '/play?scenario=speed-and-distance',
  },
];
---

<BaseLayout
  title="CueCraft — Precision Snooker Physics & Simulation Platform"
  description="Learn snooker kinematics, spin ballistics, and cushion geometry with CueCraft's deterministic 2D/3D simulator and interactive lecture drills."
>
  {/* ════════════════════════════════════════════════════════════════════════
      SECTION 1: CANOPY ARENA HERO (ASYMMETRIC STAGE + LIVE TABLE SIMULATOR)
  ════════════════════════════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden border-b border-surface-subtle bg-surface-base">
    {/* Crucible overhead spotlight gradient pool */}
    <div
      class="absolute -top-32 left-1/2 -translate-x-1/2 w-[1100px] h-[520px] rounded-full pointer-events-none opacity-80"
      style="background: radial-gradient(ellipse at center, rgba(17,87,57,0.42) 0%, rgba(11,59,38,0.18) 45%, transparent 72%);"
    />
    <div
      class="absolute top-12 right-[12%] w-[420px] h-[420px] rounded-full pointer-events-none opacity-40"
      style="background: radial-gradient(circle, rgba(226,184,87,0.16) 0%, transparent 65%);"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 lg:py-20 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        {/* Left: Editorial Copy & Bold High-Contrast Actions */}
        <div class="lg:col-span-5 hero-enter">
          <div class="inline-flex items-center gap-2.5 text-xs font-mono text-brass-primary mb-5">
            <span class="w-6 h-[1.5px] bg-brass-primary" />
            <span>Crucible Physics Lab · 2D &amp; 3D Engine</span>
          </div>

          <h1 class="font-serif text-4xl sm:text-5xl xl:text-[3.65rem] font-bold tracking-tight text-ivory-text leading-[1.05] mb-6">
            Decode Every Angle on the Baize
          </h1>

          <p class="text-sm sm:text-base text-ivory-muted leading-relaxed mb-8 max-w-lg">
            Practice championship snooker inside a deterministic physics laboratory. Dial in millimeter tip spin, compare cue shafts and cloth speeds, trace full multi-cushion ball routes, and execute shots in synced 2D or 3D.
          </p>

          <div class="flex flex-wrap items-center gap-3.5 mb-10">
            <a
              href="/play"
              class="px-7 py-3.5 rounded-lg bg-brass-primary hover:bg-brass-hover text-surface-base font-bold text-xs tracking-wider uppercase transition-colors shadow-brass-glow"
            >
              Launch Simulator
            </a>
            <a
              href="/play?mode=3d"
              class="px-6 py-3.5 rounded-lg bg-felt-surface hover:bg-felt-accent text-ivory-text border border-brass-primary/45 font-semibold text-xs tracking-wider uppercase transition-colors"
            >
              Enter 3D Arena
            </a>
            <a
              href="/lessons"
              class="px-3 py-3 text-xs font-semibold text-chalk-cyan hover:text-brass-primary transition-colors underline underline-offset-4"
            >
              Guided Drills
            </a>
          </div>

          {/* Crisp Broadcast Telemetry Strip */}
          <div class="grid grid-cols-3 gap-4 pt-6 border-t border-surface-subtle/80">
            <div>
              <div class="font-mono text-lg sm:text-xl font-bold text-brass-primary">240 Hz</div>
              <div class="text-[11px] text-ivory-faint">Rigid-Body Substeps</div>
            </div>
            <div>
              <div class="font-mono text-lg sm:text-xl font-bold text-chalk-cyan">1 : 1</div>
              <div class="text-[11px] text-ivory-faint">Ghost-Sim Route Trace</div>
            </div>
            <div>
              <div class="font-mono text-lg sm:text-xl font-bold text-ivory-text">0.05°</div>
              <div class="text-[11px] text-ivory-faint">Aim Step Resolution</div>
            </div>
          </div>
        </div>

        {/* Right: Mahogany & Burnished-Gold Framed Live Physics Stage */}
        <div class="lg:col-span-7 hero-enter-delay">
          <div class="rounded-2xl p-3 sm:p-4 bg-gradient-to-br from-[#3B1B0C] via-[#221006] to-[#140A04] border border-brass-primary/45 shadow-cushion relative">
            {/* Corner Brass Plates */}
            <span class="absolute top-1.5 left-1.5 w-3 h-3 rounded-tl-md border-t-2 border-l-2 border-brass-primary pointer-events-none" />
            <span class="absolute top-1.5 right-1.5 w-3 h-3 rounded-tr-md border-t-2 border-r-2 border-brass-primary pointer-events-none" />
            <span class="absolute bottom-1.5 left-1.5 w-3 h-3 rounded-bl-md border-b-2 border-l-2 border-brass-primary pointer-events-none" />
            <span class="absolute bottom-1.5 right-1.5 w-3 h-3 rounded-br-md border-b-2 border-r-2 border-brass-primary pointer-events-none" />

            <div class="rounded-xl bg-surface-base/95 p-3 sm:p-4 border border-brass-primary/20">
              <InteractiveHeroDemo client:load />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ════════════════════════════════════════════════════════════════════════
      SECTION 2: VISUAL DUAL-ENGINE SHOWCASE (RICH CUSTOM ILLUSTRATIONS)
  ════════════════════════════════════════════════════════════════════════ */}
  <section class="border-b border-surface-subtle bg-gradient-to-b from-surface-card/70 to-surface-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 lg:py-24">
      <div class="max-w-2xl mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-ivory-text mb-3">
          Switch Instantly Between Precision Geometry &amp; 3D Immersion
        </h2>
        <p class="text-sm text-ivory-muted leading-relaxed">
          One deterministic physics core drives both views. Analyze exact post-border trajectories top-down, then flip to 3D with five synchronized camera views and independent camera/aim control.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {/* 2D Analytical Showcase */}
        <div class="rounded-2xl bg-surface-card border border-surface-subtle overflow-hidden flex flex-col">
          <div class="bg-felt-darkest border-b border-surface-subtle p-6 relative">
            <svg viewBox="0 0 600 260" class="w-full h-auto rounded-lg shadow-felt-inset" aria-label="2D Full-Route Ballistics Diagram">
              <defs>
                <radialGradient id="baize-spot" cx="50%" cy="50%" r="65%">
                  <stop offset="0%" stop-color="#14633F" />
                  <stop offset="100%" stop-color="#052315" />
                </radialGradient>
              </defs>
              {/* Mahogany border + emerald felt */}
              <rect x="6" y="6" width="588" height="248" rx="14" fill="#3D1C0B" stroke="#E2B857" stroke-width="2" />
              <rect x="24" y="24" width="552" height="212" fill="url(#baize-spot)" />
              {/* Baulk & D */}
              <line x1="125" y1="24" x2="125" y2="236" stroke="rgba(250,247,240,0.4)" stroke-width="1.5" />
              <path d="M 125 82 A 48 48 0 0 0 125 178" fill="none" stroke="rgba(250,247,240,0.4)" stroke-width="1.5" />
              {/* Pockets */}
              <circle cx="24" cy="24" r="11" fill="#05070A" stroke="#E2B857" stroke-width="2" />
              <circle cx="300" cy="22" r="10" fill="#05070A" stroke="#E2B857" stroke-width="2" />
              <circle cx="576" cy="24" r="11" fill="#05070A" stroke="#E2B857" stroke-width="2" />
              <circle cx="24" cy="236" r="11" fill="#05070A" stroke="#E2B857" stroke-width="2" />
              <circle cx="300" cy="238" r="10" fill="#05070A" stroke="#E2B857" stroke-width="2" />
              <circle cx="576" cy="236" r="11" fill="#05070A" stroke="#E2B857" stroke-width="2" />

              {/* High-visibility cue path + ghost ball + screw curve + red multi-bounce */}
              <line x1="150" y1="145" x2="352" y2="112" stroke="#FAF7F0" stroke-width="3.2" stroke-dasharray="10 5" />
              <path d="M 352 112 Q 305 162 245 198" fill="none" stroke="#38BDF8" stroke-width="3" stroke-dasharray="6 4" />
              <polyline points="384,105 510,38 564,135" fill="none" stroke="#FF5757" stroke-width="3.2" />
              <circle cx="510" cy="38" r="4" fill="#FF5757" />

              {/* Balls */}
              <circle cx="150" cy="145" r="14" fill="#FAF7F0" />
              <circle cx="145" cy="140" r="4" fill="#FFFFFF" />
              <circle cx="352" cy="112" r="14" fill="rgba(45,212,191,0.2)" stroke="#2DD4BF" stroke-width="2.5" />
              <circle cx="352" cy="112" r="2.5" fill="#2DD4BF" />
              <circle cx="384" cy="105" r="14" fill="#E11D48" />
              <circle cx="379" cy="100" r="4" fill="#FDA4AF" />

              {/* Cue Stick */}
              <line x1="48" y1="162" x2="128" y2="149" stroke="#E2B857" stroke-width="5.5" stroke-linecap="round" />
              <line x1="124" y1="149.5" x2="130" y2="148.5" stroke="#2563EB" stroke-width="5" stroke-linecap="round" />
            </svg>
          </div>

          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-serif text-xl font-bold text-ivory-text">
                  2D Ballistics &amp; Full-Route Overlay
                </h3>
                <span class="font-mono text-[11px] text-chalk-cyan">Retina Canvas</span>
              </div>
              <p class="text-xs sm:text-sm text-ivory-muted leading-relaxed">
                High-contrast aim vectors, ghost-ball contact reticles, screw/follow curves, and complete post-collision routes for every object ball—verified against live execution with millimeter telemetry logs.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-surface-subtle flex items-center justify-between text-xs font-mono">
              <span class="text-ivory-faint">Zoom 65%–300% · Free Ball Drag (M)</span>
              <a href="/play" class="text-brass-primary hover:text-brass-hover font-bold">Open 2D View &rarr;</a>
            </div>
          </div>
        </div>

        {/* 3D Championship Showcase */}
        <div class="rounded-2xl bg-surface-card border border-surface-subtle overflow-hidden flex flex-col">
          <div class="bg-[#05080C] border-b border-surface-subtle p-6 relative">
            <svg viewBox="0 0 600 260" class="w-full h-auto rounded-lg" aria-label="3D Crucible Arena Camera Perspective">
              <defs>
                <linearGradient id="table-3d" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="#093B24" />
                  <stop offset="100%" stop-color="#136A42" />
                </linearGradient>
                <radialGradient id="canopy-glow" cx="50%" cy="20%" r="65%">
                  <stop offset="0%" stop-color="rgba(255,245,220,0.22)" />
                  <stop offset="100%" stop-color="transparent" />
                </radialGradient>
              </defs>
              {/* Arena room */}
              <rect x="0" y="0" width="600" height="260" fill="#060A10" />
              <ellipse cx="300" cy="70" rx="260" ry="120" fill="url(#canopy-glow)" />
              {/* Sconce lights */}
              <circle cx="170" cy="48" r="4" fill="#F2CE74" opacity="0.85" />
              <circle cx="430" cy="48" r="4" fill="#F2CE74" opacity="0.85" />

              {/* 3D Perspective Table */}
              <polygon points="155,86 445,86 556,248 44,248" fill="#3B1A0A" stroke="#E2B857" stroke-width="2" />
              <polygon points="172,94 428,94 522,238 78,238" fill="url(#table-3d)" />
              {/* Baulk & D in perspective */}
              <line x1="98" y1="205" x2="502" y2="205" stroke="rgba(250,247,240,0.5)" stroke-width="1.5" />
              <path d="M 245 205 C 250 232 350 232 355 205" fill="none" stroke="rgba(250,247,240,0.5)" stroke-width="1.5" />

              {/* Trajectory ray up-table */}
              <line x1="300" y1="205" x2="300" y2="132" stroke="#FAF7F0" stroke-width="2.2" />
              <line x1="300" y1="132" x2="365" y2="108" stroke="#FF5757" stroke-width="2.2" />

              {/* Balls in perspective */}
              <circle cx="300" cy="100" r="6" fill="#18181B" stroke="#52525B" stroke-width="1" />
              <circle cx="300" cy="132" r="9.5" fill="#E11D48" />
              <circle cx="297" cy="129" r="2.8" fill="#FDA4AF" />
              <circle cx="348" cy="144" r="9" fill="#2563EB" />
              {/* Cue Ball in foreground */}
              <ellipse cx="304" cy="212" rx="16" ry="7" fill="rgba(0,0,0,0.45)" />
              <circle cx="300" cy="204" r="17" fill="#FAF7F0" />
              <circle cx="294" cy="197" r="5" fill="#FFFFFF" />
              {/* Cue Stick angled behind cue ball */}
              <polygon points="295,216 305,216 312,260 288,260" fill="#E2B857" />
              <rect x="295" y="214" width="10" height="4" fill="#2563EB" />
            </svg>
          </div>

          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-serif text-xl font-bold text-ivory-text">
                  3D Crucible Views &amp; Isolated Aim
                </h3>
                <span class="font-mono text-[11px] text-brass-primary">Three.js WebGL</span>
              </div>
              <p class="text-xs sm:text-sm text-ivory-muted leading-relaxed">
                Separate <strong>Drag: Aim</strong> from <strong>Drag: Cam</strong> so the camera never jerks while lining up fine cuts. Inspect shots from 5 angles—<em>Cue</em>, <em>Target</em>, <em>Side</em>, <em>Top</em>, and <em>Orbit</em>—with <strong>Stiff</strong> or <strong>Follow</strong> shot tracking.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-surface-subtle flex items-center justify-between text-xs font-mono">
              <span class="text-ivory-faint">Lazy-Loaded · 5 Camera Angles</span>
              <a href="/play?mode=3d" class="text-brass-primary hover:text-brass-hover font-bold">Open 3D Arena &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ════════════════════════════════════════════════════════════════════════
      SECTION 3: TABLE & EQUIPMENT PHYSICS LABORATORY
  ════════════════════════════════════════════════════════════════════════ */}
  <section class="border-b border-surface-subtle bg-felt-darkest/75">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-5">
          <h2 class="font-serif text-3xl font-bold text-ivory-text mb-3">
            Tune Every Variable of the Table
          </h2>
          <p class="text-sm text-ivory-muted leading-relaxed mb-6">
            Equipment changes physics. Swap cue shafts, leather tips, baize cloth nap, and rubber cushion elasticity inside the simulator to observe squirt deflection, stopping distance, and rebound changes immediately.
          </p>
          <a
            href="/play"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-surface-card hover:bg-surface-elevated border border-brass-primary/40 text-brass-primary font-semibold text-xs uppercase tracking-wider transition-colors"
          >
            Open Table &amp; Cue Lab &rarr;
          </a>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-surface-card border border-surface-subtle">
            <div class="text-[11px] font-mono text-brass-primary uppercase mb-1">Cue Shafts</div>
            <div class="font-serif text-base font-bold text-ivory-text mb-1.5">Carbon Low-Deflection to Ash</div>
            <p class="text-xs text-ivory-muted">Compare 12% squirt carbon shafts against classic 55% ash and heavy break shafts.</p>
          </div>
          <div class="p-5 rounded-xl bg-surface-card border border-surface-subtle">
            <div class="text-[11px] font-mono text-chalk-cyan uppercase mb-1">Cue Tips</div>
            <div class="font-serif text-base font-bold text-ivory-text mb-1.5">Soft Elk · Medium · Hard Phenolic</div>
            <p class="text-xs text-ivory-muted">Modifies safe spin offset radius (0.72R–0.90R) before miscue and spin transfer bite.</p>
          </div>
          <div class="p-5 rounded-xl bg-surface-card border border-surface-subtle">
            <div class="text-[11px] font-mono text-chalk-cyan uppercase mb-1">Cloth Speed</div>
            <div class="font-serif text-base font-bold text-ivory-text mb-1.5">Crucible Worsted to Heavy Nap</div>
            <p class="text-xs text-ivory-muted">Adjust rolling friction (μr 0.022–0.056) and watch predicted roll distances scale live.</p>
          </div>
          <div class="p-5 rounded-xl bg-surface-card border border-surface-subtle">
            <div class="text-[11px] font-mono text-brass-primary uppercase mb-1">Border Elasticity</div>
            <div class="font-serif text-base font-bold text-ivory-text mb-1.5">Dead Club to High-Bounce Lab</div>
            <p class="text-xs text-ivory-muted">Set cushion restitution (e = 0.56–0.93) to study multi-rail rebound angles.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ════════════════════════════════════════════════════════════════════════
      SECTION 4: PLAYABLE LECTURES & GUIDED SCENARIOS
  ════════════════════════════════════════════════════════════════════════ */}
  <section class="border-b border-surface-subtle bg-surface-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 lg:py-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-ivory-text mb-2">
            Lectures With Built-In Interactive Drills
          </h2>
          <p class="text-sm text-ivory-muted max-w-2xl">
            Every article embeds an interactive practice table tuned to its physics lesson and opens directly in the 2D/3D simulator with preset ball layouts.
          </p>
        </div>
        <a
          href="/learn"
          class="text-xs font-mono uppercase tracking-wider text-brass-primary hover:text-brass-hover transition-colors shrink-0"
        >
          Browse All Lectures &rarr;
        </a>
      </div>

      <div class="divide-y divide-surface-subtle border-y border-surface-subtle">
        {curriculumRows.map((row) => (
          <div class="py-4 flex flex-col md:flex-row md:items-center justify-between gap-4 hover:bg-surface-card/45 px-3 transition-colors">
            <div class="max-w-2xl">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="font-serif text-base sm:text-lg font-bold text-ivory-text">
                  {row.title}
                </h3>
                <span class="text-[11px] font-mono text-chalk-cyan">{row.formula}</span>
              </div>
              <p class="text-xs text-ivory-muted mt-1">{row.summary}</p>
            </div>

            <div class="flex items-center gap-2.5 shrink-0">
              <a
                href={row.learnHref}
                class="px-3.5 py-2 rounded-lg bg-surface-card hover:bg-surface-elevated border border-surface-subtle text-xs text-ivory-muted hover:text-ivory-text transition-colors"
              >
                Read Lecture
              </a>
              <a
                href={row.playHref}
                class="px-4 py-2 rounded-lg bg-brass-primary hover:bg-brass-hover text-surface-base font-bold text-xs transition-colors"
              >
                Play Drill
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ════════════════════════════════════════════════════════════════════════
      SECTION 5: CLOSING ARENA CALLOUT
  ════════════════════════════════════════════════════════════════════════ */}
  <section class="bg-gradient-to-b from-surface-card to-surface-base">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-20 text-center">
      <h2 class="font-serif text-3xl sm:text-5xl font-bold text-ivory-text mb-4">
        Step Up to the Table
      </h2>
      <p class="text-sm sm:text-base text-ivory-muted max-w-xl mx-auto mb-8 leading-relaxed">
        Start a full 22-ball championship rack, place any ball freely on the baize, and test your positional cue-ball instincts against real physics.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/play?rack=championship"
          class="px-8 py-3.5 rounded-lg bg-brass-primary hover:bg-brass-hover text-surface-base font-bold text-xs tracking-wider uppercase transition-colors shadow-brass-glow"
        >
          Play 22-Ball Frame
        </a>
        <a
          href="/about"
          class="px-6 py-3.5 rounded-lg bg-surface-card hover:bg-surface-elevated border border-surface-subtle text-ivory-text text-xs font-semibold tracking-wider uppercase transition-colors"
        >
          Engine Architecture
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes heroEnter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-enter {
    animation: heroEnter 420ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  .hero-enter-delay {
    animation: heroEnter 520ms cubic-bezier(0.23, 1, 0.32, 1) 90ms both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter,
    .hero-enter-delay {
      animation: none;
    }
  }
</style>
