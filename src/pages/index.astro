---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HeroThreeScrollExperience } from '../components/landing/HeroThreeScrollExperience';
---

<BaseLayout
  title="CueCraft — Precision Snooker & Cue Physics Simulator"
  description="Experience deterministic 240Hz 3D snooker choreography as you scroll: cue drawback, screw pots, visible segmented cushions, and live 9-Ball / 8-Ball table morphing."
  darkScene={true}
>
  {/* Instant SSR Preloader: paints immediately from 0ms while Three.js & 240Hz physics initialize */}
  <div
    id="cuecraft-home-loader"
    class="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-[#05080C] text-white transition-opacity duration-500"
    aria-live="polite"
    aria-label="Preparing CueCraft 3D Scene"
  >
    <div
      class="absolute inset-0 opacity-[0.06] pointer-events-none"
      style="background-image: radial-gradient(#94A3B8 1px, transparent 1px); background-size: 24px 24px;"
    />
    <div
      class="absolute w-[420px] h-[420px] rounded-full pointer-events-none opacity-60"
      style="background: radial-gradient(circle, rgba(16, 185, 129, 0.14) 0%, rgba(56, 189, 248, 0.06) 45%, transparent 72%);"
    />

    <div class="relative flex flex-col items-center gap-6 px-6 select-none">
      {/* Animated Cue Ball Emblem */}
      <div class="relative w-20 h-20">
        <div class="absolute inset-0 rounded-full bg-emerald-bright/20 animate-ping" />
        <div
          class="relative w-20 h-20 rounded-full"
          style="background: radial-gradient(circle at 35% 35%, #FFFFFF 0%, #CBD5E1 48%, #334155 100%); box-shadow: 0 0 36px rgba(16, 185, 129, 0.35), 0 10px 30px rgba(0,0,0,0.75);"
        >
          <div
            class="absolute rounded-full bg-white/85"
            style="width: 26%; height: 26%; top: 18%; left: 20%;"
          />
          <div
            class="absolute rounded-full bg-emerald-bright shadow"
            style="width: 18%; height: 18%; top: 41%; left: 41%;"
          />
        </div>
        <div
          class="absolute -inset-1.5 rounded-full border-2 border-emerald-bright/50 border-t-sky-400 animate-spin"
          style="animation-duration: 1.8s;"
        />
      </div>

      <div class="text-center">
        <div class="font-display text-3xl sm:text-4xl font-bold tracking-wider text-white">
          CUE<span class="text-emerald-bright">CRAFT</span>
        </div>
        <p class="mt-1.5 text-[10px] font-mono tracking-[0.26em] uppercase text-slate-400">
          Staging 3D Table &amp; 240Hz Physics
        </p>
      </div>

      {/* Progress Shimmer Bar */}
      <div class="w-56 h-1 bg-white/[0.08] rounded-full overflow-hidden">
        <div
          class="h-full bg-gradient-to-r from-emerald-bright via-teal-300 to-sky-400 rounded-full cuecraft-loader-bar"
        />
      </div>
    </div>

    <style>
      .cuecraft-loader-bar {
        width: 35%;
        animation: cuecraft-sweep 1.2s ease-in-out infinite alternate;
      }
      @keyframes cuecraft-sweep {
        from { transform: translateX(-20%); width: 35%; }
        to { transform: translateX(185%); width: 55%; }
      }
    </style>

    {/* Failsafe guard in case WebGL fails on headless/restricted browser */}
    <script is:inline>
      (function () {
        window.__cuecraftLoaderStart = performance.now();
        window.setTimeout(function () {
          var el = document.getElementById('cuecraft-home-loader');
          if (el && el.style.opacity !== '0') {
            el.style.opacity = '0';
            el.style.pointerEvents = 'none';
            window.setTimeout(function () { el.style.display = 'none'; }, 550);
          }
        }, 4200);
      })();
    </script>
  </div>

  <HeroThreeScrollExperience client:load />
</BaseLayout>
