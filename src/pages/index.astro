---
import BaseLayout from '../layouts/BaseLayout.astro';
import { InteractiveHeroDemo } from '../components/landing/InteractiveHeroDemo';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title="CueCraft — Precision Snooker Learning & Physics Simulation"
  description="Master the art of cue ball control, screw-back ballistics, and cushion rebound physics with CueCraft's dual 2D/3D championship snooker platform."
>
  {/* SECTION 1: HERO SECTION */}
  <section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden border-b border-surface-subtle">
    {/* Subtle atmospheric ambient glow */}
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-felt-surface/20 blur-[130px] rounded-full pointer-events-none" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="flex flex-col items-center text-center max-w-4xl mx-auto mb-12">
        {/* Championship Eyebrow */}
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-card border border-brass-primary/30 text-brass-primary text-xs font-mono uppercase tracking-widest mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-brass-primary" />
          The Science of the Century Break
        </div>

        {/* Editorial Headline */}
        <h1 class="font-serif text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-ivory-text leading-[1.08] mb-6">
          Master the Physics of <br class="hidden sm:inline" />
          <span class="text-brass-primary italic font-normal">Championship Snooker</span>
        </h1>

        {/* Lead Paragraph */}
        <p class="text-base sm:text-lg text-ivory-muted leading-relaxed max-w-2xl mb-8">
          Decode cue-ball ballistics, millimeter tip contact points, and multi-cushion geometry. An authentic physics simulator and structured curriculum designed for aspiring break-builders.
        </p>

        {/* Action Buttons */}
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/play"
            class="px-8 py-4 rounded-xl bg-brass-primary text-surface-base font-bold text-sm tracking-wide uppercase hover:bg-brass-hover transition-all shadow-brass-glow active:scale-95 flex items-center gap-2"
          >
            <span>Enter Table Simulation</span>
            <span class="text-base">&rarr;</span>
          </a>
          <a
            href="/learn"
            class="px-8 py-4 rounded-xl bg-surface-card hover:bg-surface-elevated text-ivory-text border border-surface-subtle font-medium text-sm transition-colors"
          >
            Explore Physics Curriculum
          </a>
        </div>
      </div>

      {/* Interactive Hero Physics Demonstration Island */}
      <div class="max-w-5xl mx-auto">
        <InteractiveHeroDemo client:load />
      </div>
    </div>
  </section>

  {/* SECTION 2: DUAL ENGINE ARCHITECTURE (2D & 3D) */}
  <section class="py-20 md:py-28 border-b border-surface-subtle bg-surface-card/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mb-16">
        <span class="text-xs font-mono uppercase tracking-widest text-brass-primary mb-2 block">
          One Physics Engine &bull; Dual Perspectives
        </span>
        <h2 class="font-serif text-3xl sm:text-5xl font-bold text-ivory-text leading-tight mb-4">
          Engineered for Tactical Precision and Spatial Realism
        </h2>
        <p class="text-ivory-muted text-sm sm:text-base leading-relaxed">
          Switch seamlessly between top-down mathematical analysis and immersive 3D table perspectives without reloading game state. Both modes share the exact same underlying deterministic rigid-body physics core.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* 2D Mode Showcase */}
        <div class="flex flex-col bg-surface-card border border-surface-subtle rounded-2xl p-6 sm:p-8 hover:border-brass-primary/40 transition-colors">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono text-brass-primary uppercase tracking-wider font-semibold">
              Mode 01 &bull; 2D Geometric Analysis
            </span>
            <span class="px-2 py-0.5 rounded bg-surface-base border border-surface-subtle text-[11px] font-mono text-ivory-muted">
              HTML5 Canvas
            </span>
          </div>
          <h3 class="font-serif text-2xl font-bold text-ivory-text mb-3">
            The Analytical Top-Down Lens
          </h3>
          <p class="text-xs sm:text-sm text-ivory-muted leading-relaxed mb-6">
            Designed for dissecting shot geometry. Instant lookahead raycasting renders the exact line of centers, 90-degree tangent deflection angles, ghost ball target positioning, and cushion reflection vectors with sub-millimeter precision.
          </p>

          <div class="mt-auto aspect-video rounded-xl bg-felt-darkest border border-felt-border relative overflow-hidden p-4 flex flex-col justify-between shadow-felt-inset">
            <div class="flex items-center justify-between text-[11px] font-mono text-chalk-cyan">
              <span>GHOST BALL: (2200, 889)</span>
              <span>CUT: 28.4&deg;</span>
            </div>
            {/* Visual simulation mock diagram */}
            <div class="relative w-full h-24 flex items-center justify-center">
              <div class="w-8 h-8 rounded-full bg-white shadow-md border border-neutral-300 absolute left-12" />
              <div class="border-t-2 border-dashed border-chalk-cyan w-48 absolute left-20" />
              <div class="w-8 h-8 rounded-full border-2 border-chalk-cyan bg-chalk-cyan/20 absolute left-48" />
              <div class="w-8 h-8 rounded-full bg-red-600 shadow-md border border-red-400 absolute left-56" />
            </div>
            <div class="text-[10px] font-mono text-ivory-faint text-right">
              LINE OF CENTERS & TANGENT DEFLECTION
            </div>
          </div>
        </div>

        {/* 3D Mode Showcase */}
        <div class="flex flex-col bg-surface-card border border-surface-subtle rounded-2xl p-6 sm:p-8 hover:border-brass-primary/40 transition-colors">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono text-brass-primary uppercase tracking-wider font-semibold">
              Mode 02 &bull; 3D Tactile Presence
            </span>
            <span class="px-2 py-0.5 rounded bg-surface-base border border-surface-subtle text-[11px] font-mono text-ivory-muted">
              Three.js PBR
            </span>
          </div>
          <h3 class="font-serif text-2xl font-bold text-ivory-text mb-3">
            Championship Room Immersion
          </h3>
          <p class="text-xs sm:text-sm text-ivory-muted leading-relaxed mb-6">
            Step down to table level. PBR West-of-England wool felt, polished mahogany cushion rails, hand-rubbed brass corner plates, overhead canopy spotlights, and authentic quaternion ball roll matching exact angular velocity vectors.
          </p>

          <div class="mt-auto aspect-video rounded-xl bg-surface-base border border-surface-subtle relative overflow-hidden p-4 flex flex-col justify-between">
            <div class="flex items-center justify-between text-[11px] font-mono text-brass-primary">
              <span>CANOPY LIGHTING: 4x SPOT</span>
              <span>ANGULAR VELOCITY &omega;</span>
            </div>
            {/* Perspective wireframe diagram */}
            <div class="relative w-full h-24 flex items-center justify-center">
              <div class="w-48 h-14 border border-brass-muted/50 rounded-lg transform -skew-x-12 bg-felt-surface/40 flex items-center justify-around px-4">
                <span class="w-4 h-4 rounded-full bg-white shadow-brass-glow" />
                <span class="w-4 h-4 rounded-full bg-red-600" />
                <span class="w-4 h-4 rounded-full bg-black" />
              </div>
            </div>
            <div class="text-[10px] font-mono text-ivory-faint text-right">
              PHYSICAL MATERIAL SPECULARITY & DEPTH
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* SECTION 3: THE PHYSICS OF BALLISTICS */}
  <section class="py-20 md:py-28 border-b border-surface-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mb-16">
        <span class="text-xs font-mono uppercase tracking-widest text-brass-primary mb-2 block">
          Classical Mechanics Applied
        </span>
        <h2 class="font-serif text-3xl sm:text-5xl font-bold text-ivory-text leading-tight mb-4">
          Four Physical Pillars Behind Every Century Break
        </h2>
        <p class="text-ivory-muted text-sm sm:text-base leading-relaxed">
          Snooker is not a game of chance. It is applied physics. CueCraft accurately models the interplay between sliding friction, rolling resistance, impulse transfer, and cushion rubber restitution.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {/* Pillar 1 */}
        <div class="bg-surface-card border border-surface-subtle p-6 rounded-2xl flex flex-col">
          <div class="w-10 h-10 rounded-lg bg-surface-base border border-surface-subtle flex items-center justify-center mb-4 text-brass-primary font-mono font-bold text-sm">
            01
          </div>
          <h3 class="font-serif text-lg font-bold text-ivory-text mb-2">
            The Stun & 90&deg; Tangent
          </h3>
          <p class="text-xs text-ivory-muted leading-relaxed">
            When a cue ball strikes without rotational spin at impact, all forward energy along the line of centers is absorbed by the object ball. The cue ball deflects along an exact 90-degree tangent line.
          </p>
          <div class="mt-4 pt-3 border-t border-surface-subtle text-[11px] font-mono text-brass-muted">
            &Delta;v<sub>normal</sub> = J / m &bull; &theta; = 90&deg;
          </div>
        </div>

        {/* Pillar 2 */}
        <div class="bg-surface-card border border-surface-subtle p-6 rounded-2xl flex flex-col">
          <div class="w-10 h-10 rounded-lg bg-surface-base border border-surface-subtle flex items-center justify-center mb-4 text-brass-primary font-mono font-bold text-sm">
            02
          </div>
          <h3 class="font-serif text-lg font-bold text-ivory-text mb-2">
            Screw-Back (Draw)
          </h3>
          <p class="text-xs text-ivory-muted leading-relaxed">
            Struck below center, the cue ball slides forward with reverse angular rotation. Upon collision, linear velocity halts while the remaining backspin bites into the baize, driving the ball backwards.
          </p>
          <div class="mt-4 pt-3 border-t border-surface-subtle text-[11px] font-mono text-brass-muted">
            &omega;<sub>pitch</sub> &lt; 0 &bull; F<sub>cloth</sub> = -&mu;<sub>s</sub>mg
          </div>
        </div>

        {/* Pillar 3 */}
        <div class="bg-surface-card border border-surface-subtle p-6 rounded-2xl flex flex-col">
          <div class="w-10 h-10 rounded-lg bg-surface-base border border-surface-subtle flex items-center justify-center mb-4 text-brass-primary font-mono font-bold text-sm">
            03
          </div>
          <h3 class="font-serif text-lg font-bold text-ivory-text mb-2">
            Topspin Follow
          </h3>
          <p class="text-xs text-ivory-muted leading-relaxed">
            Struck above center, the cue ball possesses excess rotational momentum. When the collision absorbs linear velocity, the forward spin pulls the cue ball forward through the contact line.
          </p>
          <div class="mt-4 pt-3 border-t border-surface-subtle text-[11px] font-mono text-brass-muted">
            &omega;<sub>pitch</sub> &gt; v/R &bull; Follow Acceleration
          </div>
        </div>

        {/* Pillar 4 */}
        <div class="bg-surface-card border border-surface-subtle p-6 rounded-2xl flex flex-col">
          <div class="w-10 h-10 rounded-lg bg-surface-base border border-surface-subtle flex items-center justify-center mb-4 text-brass-primary font-mono font-bold text-sm">
            04
          </div>
          <h3 class="font-serif text-lg font-bold text-ivory-text mb-2">
            Running vs Check Side
          </h3>
          <p class="text-xs text-ivory-muted leading-relaxed">
            Side spin modifies cushion rebounds. Running side widens the exit angle and maintains speed. Check side grips the rubber, bites against rebound momentum, and narrows the exit trajectory.
          </p>
          <div class="mt-4 pt-3 border-t border-surface-subtle text-[11px] font-mono text-brass-muted">
            v'<sub>t</sub> = v<sub>t</sub> &plusmn; &mu;<sub>c</sub> &omega;<sub>yaw</sub>R
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* SECTION 4: STRUCTURED CURRICULUM PREVIEW */}
  <section class="py-20 md:py-28 border-b border-surface-subtle bg-surface-card/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
        <div class="max-w-2xl">
          <span class="text-xs font-mono uppercase tracking-widest text-brass-primary mb-2 block">
            Pedagogical Masterclass
          </span>
          <h2 class="font-serif text-3xl sm:text-5xl font-bold text-ivory-text leading-tight">
            From Fundamental Potting to Advanced Positional Play
          </h2>
        </div>
        <a
          href="/learn"
          class="inline-flex items-center gap-2 text-sm text-brass-primary hover:text-brass-hover font-semibold transition-colors group"
        >
          <span>View All 12 Educational Modules</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Module 1 */}
        <a
          href="/learn/cue-ball-control"
          class="group p-6 rounded-2xl bg-surface-card border border-surface-subtle hover:border-brass-primary/50 transition-all flex flex-col"
        >
          <span class="text-[11px] font-mono text-brass-muted uppercase tracking-wider mb-2">
            Module 01 &bull; Core Kinematics
          </span>
          <h3 class="font-serif text-xl font-bold text-ivory-text group-hover:text-brass-hover transition-colors mb-2">
            Understanding Cue-Ball Control & Stun
          </h3>
          <p class="text-xs text-ivory-muted leading-relaxed mb-6">
            Learn why stopping the cue ball dead at impact is the cornerstone of break-building and how speed affects the sliding-to-rolling transition.
          </p>
          <div class="mt-auto flex items-center justify-between text-xs font-mono text-brass-primary">
            <span>Read Article &amp; Scenarios</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        {/* Module 2 */}
        <a
          href="/learn/side-spin-ballistics"
          class="group p-6 rounded-2xl bg-surface-card border border-surface-subtle hover:border-brass-primary/50 transition-all flex flex-col"
        >
          <span class="text-[11px] font-mono text-brass-muted uppercase tracking-wider mb-2">
            Module 02 &bull; Rotational Dynamics
          </span>
          <h3 class="font-serif text-xl font-bold text-ivory-text group-hover:text-brass-hover transition-colors mb-2">
            Side Spin, Swerve &amp; Cushion Bite
          </h3>
          <p class="text-xs text-ivory-muted leading-relaxed mb-6">
            Master the subtle differences between running english and check english, and understand how cue ball squirt and throw influence aim lines.
          </p>
          <div class="mt-auto flex items-center justify-between text-xs font-mono text-brass-primary">
            <span>Read Article &amp; Scenarios</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        {/* Module 3 */}
        <a
          href="/learn/cushion-rebounds"
          class="group p-6 rounded-2xl bg-surface-card border border-surface-subtle hover:border-brass-primary/50 transition-all flex flex-col"
        >
          <span class="text-[11px] font-mono text-brass-muted uppercase tracking-wider mb-2">
            Module 03 &bull; Multi-Angle Escapes
          </span>
          <h3 class="font-serif text-xl font-bold text-ivory-text group-hover:text-brass-hover transition-colors mb-2">
            Multi-Cushion Escape Geometries
          </h3>
          <p class="text-xs text-ivory-muted leading-relaxed mb-6">
            Calculate complex two-cushion and three-cushion rebound paths to escape snookers and leave object balls safe on the baulk cushion.
          </p>
          <div class="mt-auto flex items-center justify-between text-xs font-mono text-brass-primary">
            <span>Read Article &amp; Scenarios</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* SECTION 5: FINAL CALL TO ACTION */}
  <section class="py-24 relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center relative z-10">
      <div class="w-12 h-12 rounded-xl bg-felt-surface border border-brass-primary/40 flex items-center justify-center mx-auto mb-6 shadow-brass-glow">
        <span class="w-4 h-4 rounded-full bg-brass-primary" />
      </div>

      <h2 class="font-serif text-4xl sm:text-6xl font-bold text-ivory-text leading-tight mb-6">
        Step Up to the Baize
      </h2>

      <p class="text-base text-ivory-muted max-w-xl mx-auto leading-relaxed mb-10">
        Whether you are practicing subtle stun shots or preparing for tournament competition, CueCraft gives you the physics precision you need.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/play"
          class="px-10 py-4 rounded-xl bg-brass-primary text-surface-base font-bold text-sm tracking-wide uppercase hover:bg-brass-hover transition-all shadow-brass-glow active:scale-95 flex items-center gap-2"
        >
          <span>Launch Simulator</span>
          <span>&rarr;</span>
        </a>
        <a
          href="/about"
          class="px-8 py-4 rounded-xl bg-surface-card hover:bg-surface-elevated text-ivory-text border border-surface-subtle font-medium text-sm transition-colors"
        >
          Read Platform Philosophy
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
