---
import BaseLayout from '../layouts/BaseLayout.astro';
import { InteractiveHeroDemo } from '../components/landing/InteractiveHeroDemo';

const curriculumRows = [
  {
    title: 'Dead-Stop Stun & Momentum Transfer',
    topic: 'Kinematics',
    metric: 'v_normal = 0 · 90° Tangent',
    learnHref: '/learn/cue-ball-control',
    playHref: '/play?scenario=cue-ball-control',
  },
  {
    title: 'Screw-Back Draw & Topspin Follow',
    topic: '2D Slip Vector',
    metric: 'F_slip = −μs mg (v − u_roll)',
    learnHref: '/learn/topspin-and-backspin',
    playHref: '/play?scenario=topspin-and-backspin',
  },
  {
    title: 'Running Side, Check Side & Elevated Swerve',
    topic: 'Rotational English',
    metric: 'e_yaw · Cue Squirt + Curve',
    learnHref: '/learn/side-spin-ballistics',
    playHref: '/play?scenario=side-spin-ballistics',
  },
  {
    title: 'Multi-Cushion Escapes & Border Strength',
    topic: 'Rebound Restitution',
    metric: 'e_c = 0.56 – 0.93',
    learnHref: '/learn/cushion-rebounds',
    playHref: '/play?scenario=cushion-rebounds',
  },
  {
    title: 'Cut-Induced Throw & Collision Geometry',
    topic: 'Line of Centers',
    metric: '2R = 52.5 mm Ghost Contact',
    learnHref: '/learn/collision-angles',
    playHref: '/play?scenario=collision-angles',
  },
  {
    title: 'Stopping Distance & Cloth Friction Regimes',
    topic: 'Rolling Resistance',
    metric: 'μr = 0.022 – 0.056',
    learnHref: '/learn/speed-and-distance',
    playHref: '/play?scenario=speed-and-distance',
  },
];
---

<BaseLayout
  title="CueCraft — Precision Snooker Physics & Simulation Platform"
  description="Learn snooker kinematics, spin ballistics, and cushion geometry with CueCraft's deterministic 2D/3D simulator and interactive lecture drills."
>
  {/* ════════════════════════════════════════════════════════════════════════
      HERO: ASYMMETRIC EDITORIAL SPLIT + LIVE RIGID-BODY SIMULATION
  ════════════════════════════════════════════════════════════════════════ */}
  <section class="relative border-b border-surface-subtle bg-surface-base overflow-hidden">
    {/* Subtle technical drafting lines */}
    <svg
      class="absolute inset-0 w-full h-full opacity-[0.045] pointer-events-none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <pattern id="draft-grid" width="64" height="64" patternUnits="userSpaceOnUse">
          <path d="M 64 0 L 0 0 0 64" fill="none" stroke="#C5A059" stroke-width="0.75" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#draft-grid)" />
    </svg>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 lg:py-20 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        {/* Left Column: Editorial Headline & Direct Entry */}
        <div class="lg:col-span-5 hero-reveal">
          <h1 class="font-serif text-4xl sm:text-5xl xl:text-6xl font-bold tracking-tight text-ivory-text leading-[1.06] mb-6">
            Master Snooker From First Principles
          </h1>

          <p class="text-sm sm:text-base text-ivory-muted leading-relaxed mb-8 max-w-lg">
            CueCraft is an interactive snooker learning lab and playable 2D/3D table simulator. Experiment with millimeter tip offsets, spin curves, cloth speeds, cushion bounce strength, and exact forward-simulated ball trajectories.
          </p>

          <div class="flex flex-wrap items-center gap-3 mb-10">
            <a
              href="/play"
              class="px-6 py-3.5 rounded-lg bg-brass-primary hover:bg-brass-hover text-surface-base font-bold text-xs tracking-wider uppercase transition-colors shadow-brass-glow"
            >
              Launch 2D Simulator
            </a>
            <a
              href="/play?mode=3d"
              class="px-6 py-3.5 rounded-lg bg-felt-surface hover:bg-felt-accent text-ivory-text border border-felt-border font-semibold text-xs tracking-wider uppercase transition-colors"
            >
              Enter 3D Table View
            </a>
            <a
              href="/lessons"
              class="px-4 py-3.5 text-xs font-medium text-ivory-muted hover:text-brass-primary transition-colors underline underline-offset-4"
            >
              Browse Guided Drills
            </a>
          </div>

          {/* Concise Technical Ledger */}
          <dl class="grid grid-cols-3 gap-4 pt-6 border-t border-surface-subtle text-xs">
            <div>
              <dt class="text-ivory-faint font-sans">Table Dimensions</dt>
              <dd class="font-mono text-ivory-text font-semibold mt-0.5">3569 × 1778 mm</dd>
            </div>
            <div>
              <dt class="text-ivory-faint font-sans">Physics Integrator</dt>
              <dd class="font-mono text-ivory-text font-semibold mt-0.5">240 Hz Substep</dd>
            </div>
            <div>
              <dt class="text-ivory-faint font-sans">Prediction Mode</dt>
              <dd class="font-mono text-chalk-cyan font-semibold mt-0.5">1:1 Ghost Sim</dd>
            </div>
          </dl>
        </div>

        {/* Right Column: Live Interactive Canvas */}
        <div class="lg:col-span-7 hero-reveal-delayed">
          <InteractiveHeroDemo client:load />
        </div>
      </div>
    </div>
  </section>

  {/* ════════════════════════════════════════════════════════════════════════
      SECTION 2: TWO LENSES — SHARED DETERMINISTIC ENGINE
  ════════════════════════════════════════════════════════════════════════ */}
  <section class="border-b border-surface-subtle bg-surface-card/35">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        {/* Left: 2D Analytical Geometry */}
        <div class="lg:col-span-6 lg:pr-10 lg:border-r border-surface-subtle">
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ivory-text mb-3">
            2D Ballistics &amp; Full-Route Trace
          </h2>
          <p class="text-sm text-ivory-muted leading-relaxed mb-6 max-w-xl">
            Every shot preview runs the identical fixed-timestep rigid-body equations used during live execution. Before you strike, see exactly how far the cue ball travels, how screw and follow curve after impact, and where every struck object ball rebounds off the borders.
          </p>

          {/* Clean geometric SVG schematic */}
          <div class="rounded-xl bg-felt-darkest border border-felt-border p-5 shadow-felt-inset">
            <svg viewBox="0 0 560 220" class="w-full h-auto" aria-label="2D Ghost Ball and Screw Trajectory Diagram">
              {/* Baulk line */}
              <line x1="90" y1="12" x2="90" y2="208" stroke="rgba(245,242,235,0.28)" stroke-width="1.5" />
              <path d="M 90 60 A 50 50 0 0 0 90 160" fill="none" stroke="rgba(245,242,235,0.28)" stroke-width="1.5" />

              {/* Cue path */}
              <line x1="120" y1="130" x2="292" y2="110" stroke="#F7F5EE" stroke-width="2" stroke-dasharray="6 4" />
              {/* Post-impact screw curve */}
              <path d="M 292 110 Q 250 140 190 165" fill="none" stroke="#38BDF8" stroke-width="2" stroke-dasharray="4 3" />
              {/* Object ball path + cushion bounce */}
              <polyline points="324,102 455,22 520,115" fill="none" stroke="#EF4444" stroke-width="2.2" />

              {/* Balls */}
              <circle cx="120" cy="130" r="14" fill="#F7F5EE" />
              <circle cx="292" cy="110" r="14" fill="rgba(45,212,191,0.18)" stroke="#2DD4BF" stroke-width="1.8" />
              <circle cx="324" cy="102" r="14" fill="#DC2626" />

              {/* Annotations */}
              <text x="108" y="164" fill="#C8CFDA" font-family="monospace" font-size="10">Cue Ball (-0.75Y Screw)</text>
              <text x="242" y="84" fill="#2DD4BF" font-family="monospace" font-size="10">Ghost Contact (2R)</text>
              <text x="366" y="42" fill="#EF4444" font-family="monospace" font-size="10">Target Cushion Reflection</text>
              <text x="155" y="182" fill="#38BDF8" font-family="monospace" font-size="10">Parabolic Draw Curve</text>
            </svg>
          </div>
        </div>

        {/* Right: 3D Multi-Camera Simulation */}
        <div class="lg:col-span-6">
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ivory-text mb-3">
            3D Room Immersion &amp; Multi-Angle Cameras
          </h2>
          <p class="text-sm text-ivory-muted leading-relaxed mb-6 max-w-xl">
            Inspect the same shot from behind the cue, behind the pocket, from side cue-elevation profile, top-down, or free 360° orbit. Lock the camera stiffly during shots or track the cue ball in real time, and drag balls anywhere on the felt in Setup Mode.
          </p>

          <div class="space-y-3 border-t border-surface-subtle pt-5 text-xs">
            <div class="flex items-baseline justify-between py-2 border-b border-surface-subtle/60">
              <span class="font-semibold text-ivory-text">5 Synchronized Camera Stances</span>
              <span class="font-mono text-brass-primary">Cue · Target · Side · Top · Orbit</span>
            </div>
            <div class="flex items-baseline justify-between py-2 border-b border-surface-subtle/60">
              <span class="font-semibold text-ivory-text">Dynamic Cue &amp; Tip Customization</span>
              <span class="font-mono text-brass-primary">Carbon · Ash · Maple · Soft/Hard Tip</span>
            </div>
            <div class="flex items-baseline justify-between py-2 border-b border-surface-subtle/60">
              <span class="font-semibold text-ivory-text">Tunable Table Surfaces &amp; Borders</span>
              <span class="font-mono text-chalk-cyan">μr 0.022–0.056 · Restitution 0.56–0.93</span>
            </div>
            <div class="flex items-baseline justify-between py-2">
              <span class="font-semibold text-ivory-text">Free Ball Placement Mode</span>
              <span class="font-mono text-chalk-cyan">Drag Any Ball in 2D or 3D</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ════════════════════════════════════════════════════════════════════════
      SECTION 3: PHYSICS CURRICULUM & PLAYABLE LECTURE DRILLS
  ════════════════════════════════════════════════════════════════════════ */}
  <section class="border-b border-surface-subtle bg-surface-base">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 lg:py-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-ivory-text mb-2">
            Theory Paired With Playable Drills
          </h2>
          <p class="text-sm text-ivory-muted max-w-2xl">
            Every concept in our Learning Center ships with an interactive table scenario tuned to that exact physics lesson. Read the mechanics, adjust the tip offset, and strike the shot yourself.
          </p>
        </div>
        <a
          href="/learn"
          class="text-xs font-mono uppercase tracking-wider text-brass-primary hover:text-brass-hover transition-colors shrink-0"
        >
          All Physics Articles &rarr;
        </a>
      </div>

      {/* Editorial Ledger Table */}
      <div class="divide-y divide-surface-subtle border-y border-surface-subtle">
        {curriculumRows.map((row) => (
          <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-surface-card/40 px-2 transition-colors">
            <div class="min-w-0">
              <div class="flex items-center gap-3">
                <h3 class="font-serif text-base sm:text-lg font-bold text-ivory-text">
                  {row.title}
                </h3>
                <span class="text-[11px] font-mono text-ivory-faint hidden sm:inline">
                  {row.topic}
                </span>
              </div>
              <p class="text-xs font-mono text-chalk-cyan mt-0.5">{row.metric}</p>
            </div>

            <div class="flex items-center gap-3 shrink-0">
              <a
                href={row.learnHref}
                class="px-3 py-1.5 rounded-lg bg-surface-card hover:bg-surface-elevated border border-surface-subtle text-xs text-ivory-muted hover:text-ivory-text transition-colors"
              >
                Read Lecture
              </a>
              <a
                href={row.playHref}
                class="px-3.5 py-1.5 rounded-lg bg-brass-primary hover:bg-brass-hover text-surface-base font-bold text-xs transition-colors"
              >
                Play Drill
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ════════════════════════════════════════════════════════════════════════
      SECTION 4: CLOSING STATEMENT
  ════════════════════════════════════════════════════════════════════════ */}
  <section class="bg-felt-darkest">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-20 text-center">
      <h2 class="font-serif text-3xl sm:text-5xl font-bold text-ivory-text mb-4">
        Step Up to the Baize
      </h2>
      <p class="text-sm sm:text-base text-ivory-muted max-w-xl mx-auto mb-8 leading-relaxed">
        Open the free-play 22-ball championship rack, customize your cue shaft and cloth speed, or verify shot error down to the millimeter.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/play?rack=championship"
          class="px-8 py-3.5 rounded-lg bg-brass-primary hover:bg-brass-hover text-surface-base font-bold text-xs tracking-wider uppercase transition-colors shadow-brass-glow"
        >
          Start 22-Ball Frame
        </a>
        <a
          href="/about"
          class="px-6 py-3.5 rounded-lg bg-surface-card hover:bg-surface-elevated border border-surface-subtle text-ivory-text text-xs font-semibold tracking-wider uppercase transition-colors"
        >
          Platform Architecture
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes heroEnter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-reveal {
    animation: heroEnter 420ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }

  .hero-reveal-delayed {
    animation: heroEnter 520ms cubic-bezier(0.23, 1, 0.32, 1) 80ms both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal,
    .hero-reveal-delayed {
      animation: none;
    }
  }
</style>
