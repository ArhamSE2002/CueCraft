---
import BaseLayout from '../../layouts/BaseLayout.astro';

const modules = [
  {
    slug: 'cue-ball-control',
    number: '01',
    title: 'Understanding Cue-Ball Control & Stun',
    category: 'Kinematics',
    summary: 'Master the sliding-to-rolling friction transition, dead-stop stun shots, and the fundamental physics of potting without cue-ball drift.',
    readingTime: '6 min read',
  },
  {
    slug: 'side-spin-ballistics',
    number: '02',
    title: 'Side Spin, Swerve & Cushion Bite',
    category: 'Rotational Dynamics',
    summary: 'Understand running English versus check English, cue squirt deflection, and how side spin modifies cushion rebound angles.',
    readingTime: '8 min read',
  },
  {
    slug: 'cushion-rebounds',
    number: '03',
    title: 'Cushion Rebounds & Multi-Angle Escapes',
    category: 'Geometry',
    summary: 'Normal restitution, tangent rubber friction, and systematic calculation of two- and three-cushion escape paths.',
    readingTime: '7 min read',
  },
  {
    slug: 'collision-angles',
    number: '04',
    title: 'Ball Collision Angles & The 90° Rule',
    category: 'Collision Mechanics',
    summary: 'Why equal-mass spheres separate at 90 degrees, and how cut-induced throw imparts spin to object balls.',
    readingTime: '5 min read',
  },
  {
    slug: 'speed-and-distance',
    number: '05',
    title: 'Speed, Distance & Rolling Resistance',
    category: 'Friction Dynamics',
    summary: 'Calculating stopping distances on worsted and club baize based on initial cue impulse velocity.',
    readingTime: '6 min read',
  },
  {
    slug: 'topspin-and-backspin',
    number: '06',
    title: 'Topspin (Follow) and Backspin (Screw)',
    category: 'Spin Ballistics',
    summary: 'How vertical tip offset creates angular torque and why screw-back exhibits delayed reversal.',
    readingTime: '7 min read',
  },
];
---

<BaseLayout
  title="The Science of Snooker — Learning Center"
  description="Master snooker and cue sports physics through guided lectures covering cue ball control, spin ballistics, cushion restitution, and collision angles."
  darkScene={true}
>
  <div class="relative overflow-hidden">
    {/* Canopy Ambient Glow */}
    <div
      class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[420px] rounded-full pointer-events-none opacity-65"
      style="background: radial-gradient(ellipse at center, rgba(16, 185, 129, 0.16) 0%, rgba(56, 189, 248, 0.06) 45%, transparent 72%);"
      aria-hidden="true"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 relative z-10">
      <div class="max-w-3xl mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.05] border border-white/[0.12] text-emerald-bright text-xs font-mono uppercase tracking-wider font-bold mb-5">
          Educational Curriculum
        </div>
        <h1 class="font-display text-4xl sm:text-6xl font-bold text-white leading-[1.04] mb-5">
          The Science of <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-bright to-sky-400">Cue Control</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          Great break-building is classical mechanics in motion. Every guide includes an interactive table drill wired directly to our deterministic engine.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {modules.map((item) => (
          <a
            href={`/learn/${item.slug}`}
            class="group flex flex-col bg-[#080C12]/80 backdrop-blur-xl border border-white/[0.10] hover:border-emerald-bright/60 rounded-3xl p-6 transition-all hover:-translate-y-0.5 shadow-xl"
          >
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs text-emerald-bright font-bold">
                MODULE {item.number}
              </span>
              <span class="text-[11px] font-mono text-sky-400 px-2.5 py-0.5 rounded-full bg-white/[0.05] border border-white/[0.10]">
                {item.category}
              </span>
            </div>

            <h2 class="font-display text-xl font-bold text-white group-hover:text-emerald-bright transition-colors mb-3 leading-snug">
              {item.title}
            </h2>

            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
              {item.summary}
            </p>

            <div class="mt-auto pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono text-slate-400 group-hover:text-emerald-bright transition-colors font-semibold">
              <span>{item.readingTime}</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
