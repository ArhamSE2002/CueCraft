---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lessons = [
  {
    id: 'cue-ball-control',
    level: 'Beginner',
    title: 'The Dead Stop Stun',
    targetZone: 'Pot Red & Freeze Cue Ball Near Impact',
    difficulty: '★☆☆☆☆',
    description: 'Learn the exact balance of cue power and slight backspin that eliminates forward roll upon contacting the object ball.',
    lectureSlug: 'cue-ball-control',
  },
  {
    id: 'topspin-and-backspin',
    level: 'Intermediate',
    title: 'Screw Back for Black Position',
    targetZone: 'Pot Red & Draw Cue Ball Back to Center',
    difficulty: '★★★☆☆',
    description: 'Pot the red and use low cue tip contact (-0.75Y) to draw the cue ball smoothly backward onto high-value position.',
    lectureSlug: 'topspin-and-backspin',
  },
  {
    id: 'topspin-follow',
    level: 'Intermediate',
    title: 'Topspin Follow-Through Break',
    targetZone: 'Drive Past Contact Line Toward Black',
    difficulty: '★★☆☆☆',
    description: 'High tip contact (+0.78Y) generates forward angular momentum, propelling the cue ball cleanly through the contact line.',
    lectureSlug: 'topspin-and-backspin',
  },
  {
    id: 'cushion-rebounds',
    level: 'Advanced',
    title: 'Two-Cushion Snooker Escape',
    targetZone: 'Escape Blocking Colors via Two Rails',
    difficulty: '★★★★☆',
    description: 'Calculate multi-cushion rebound paths factoring normal cushion restitution (e ≈ 0.72) to escape tight snookers.',
    lectureSlug: 'cushion-rebounds',
  },
  {
    id: 'side-spin-ballistics',
    level: 'Master',
    title: 'Running Side Cushion Drift',
    targetZone: 'Widen Rebound Angle Off Bottom Cushion',
    difficulty: '★★★★★',
    description: 'Apply heavy right running English to widen cushion exit angles and maintain speed down the table.',
    lectureSlug: 'side-spin-ballistics',
  },
  {
    id: 'masse-swerve',
    level: 'Master',
    title: 'Elevated Masse Swerve Around Ball',
    targetZone: 'Bend Around Blocking Blue to Strike Red',
    difficulty: '★★★★★',
    description: 'Elevate the cue butt to 40° with heavy right English to curve the cue ball laterally around an obstructing color.',
    lectureSlug: 'side-spin-ballistics',
  },
];
---

<BaseLayout
  title="Interactive Lessons & Guided Scenarios — CueCraft"
  description="Structured snooker challenges and interactive scenarios designed to test cue-ball positioning, screw-back, and cushion escapes."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16">
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-card border border-brass-primary/30 text-brass-primary text-xs font-mono uppercase tracking-widest mb-4">
        Interactive Curriculum
      </div>
      <h1 class="font-serif text-4xl sm:text-6xl font-bold text-ivory-text leading-tight mb-6">
        Guided Practice Scenarios
      </h1>
      <p class="text-base sm:text-lg text-ivory-muted leading-relaxed">
        Step-by-step table drills loaded directly into our deterministic 2D/3D engine with preset setups, physics notes, and full route visualization.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {lessons.map((lesson) => (
        <div class="bg-surface-card border border-surface-subtle p-6 rounded-2xl flex flex-col justify-between hover:border-brass-primary/40 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface-base border border-surface-subtle text-brass-primary font-bold">
                {lesson.level}
              </span>
              <span class="text-xs font-mono text-brass-primary tracking-widest">
                {lesson.difficulty}
              </span>
            </div>

            <h2 class="font-serif text-xl font-bold text-ivory-text mb-2">
              {lesson.title}
            </h2>

            <p class="text-xs text-ivory-muted leading-relaxed mb-4">
              {lesson.description}
            </p>

            <div class="p-3 rounded-xl bg-surface-base border border-surface-subtle text-[11px] font-mono text-chalk-cyan mb-6">
              OBJECTIVE: {lesson.targetZone}
            </div>
          </div>

          <div class="flex items-center gap-3">
            <a
              href={`/play?scenario=${lesson.id}`}
              class="flex-1 py-2.5 px-4 rounded-xl bg-brass-primary hover:bg-brass-hover text-surface-base font-bold text-xs tracking-wider uppercase text-center transition-colors shadow-sm flex items-center justify-center gap-2"
            >
              <span>Play Scenario</span>
              <span>&rarr;</span>
            </a>
            <a
              href={`/learn/${lesson.lectureSlug}`}
              class="py-2.5 px-4 rounded-xl bg-surface-base hover:bg-surface-elevated border border-surface-subtle text-ivory-muted hover:text-ivory-text font-medium text-xs transition-colors"
            >
              Theory
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
