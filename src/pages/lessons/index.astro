---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lessons = [
  {
    id: 'cue-ball-control',
    level: 'Beginner',
    title: 'The Dead Stop Stun',
    targetZone: 'Pot Red & Freeze Cue Ball Near Impact',
    difficulty: '1 / 5',
    description: 'Balance cue power and slight backspin to eliminate forward roll at the exact moment of impact.',
    lectureSlug: 'cue-ball-control',
  },
  {
    id: 'topspin-and-backspin',
    level: 'Intermediate',
    title: 'Screw Back for Black Position',
    targetZone: 'Pot Red & Draw Cue Ball Back to Center',
    difficulty: '3 / 5',
    description: 'Pot the red using low tip contact (-0.75Y) to draw the cue ball smoothly backward onto high-value position.',
    lectureSlug: 'topspin-and-backspin',
  },
  {
    id: 'topspin-follow',
    level: 'Intermediate',
    title: 'Topspin Follow-Through Break',
    targetZone: 'Drive Past Contact Line Toward Black',
    difficulty: '2 / 5',
    description: 'High tip contact (+0.78Y) generates forward angular momentum, propelling the cue ball cleanly through the contact line.',
    lectureSlug: 'topspin-and-backspin',
  },
  {
    id: 'cushion-rebounds',
    level: 'Advanced',
    title: 'Two-Cushion Snooker Escape',
    targetZone: 'Escape Blocking Colors via Two Rails',
    difficulty: '4 / 5',
    description: 'Calculate multi-cushion rebound paths factoring normal cushion restitution (e ≈ 0.72) to escape tight snookers.',
    lectureSlug: 'cushion-rebounds',
  },
  {
    id: 'side-spin-ballistics',
    level: 'Master',
    title: 'Running Side Cushion Drift',
    targetZone: 'Widen Rebound Angle Off Bottom Cushion',
    difficulty: '5 / 5',
    description: 'Apply heavy right running English to widen cushion exit angles and maintain speed down the table.',
    lectureSlug: 'side-spin-ballistics',
  },
  {
    id: 'masse-swerve',
    level: 'Master',
    title: 'Elevated Masse Swerve Around Ball',
    targetZone: 'Bend Around Blocking Blue to Strike Red',
    difficulty: '5 / 5',
    description: 'Elevate the cue butt to 40° with heavy right English to curve the cue ball laterally around an obstructing color.',
    lectureSlug: 'side-spin-ballistics',
  },
];
---

<BaseLayout
  title="Interactive Lessons & Guided Scenarios — CueCraft"
  description="Structured cue sports drills designed to train stun, screw-back, topspin follow, and multi-cushion escapes in 2D and 3D."
  darkScene={true}
>
  <div class="relative overflow-hidden">
    <div
      class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[420px] rounded-full pointer-events-none opacity-65"
      style="background: radial-gradient(ellipse at center, rgba(56, 189, 248, 0.14) 0%, rgba(16, 185, 129, 0.08) 45%, transparent 72%);"
      aria-hidden="true"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 relative z-10">
      <div class="max-w-3xl mb-14">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/[0.05] border border-white/[0.12] text-emerald-bright text-xs font-mono uppercase tracking-wider font-bold mb-5">
          Interactive Drills
        </div>
        <h1 class="font-display text-4xl sm:text-6xl font-bold text-white leading-[1.04] mb-5">
          Guided <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-bright to-sky-400">Practice Scenarios</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          Step-by-step table drills loaded directly into the deterministic 2D/3D simulator with preset ball layouts and recommended spin settings.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {lessons.map((lesson) => (
          <div class="bg-[#080C12]/80 backdrop-blur-xl border border-white/[0.10] p-6 rounded-3xl flex flex-col justify-between hover:border-emerald-bright/60 transition-all shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-emerald-bright/15 text-emerald-bright font-bold border border-emerald-bright/25">
                  {lesson.level}
                </span>
                <span class="text-xs font-mono text-slate-400">
                  Difficulty {lesson.difficulty}
                </span>
              </div>

              <h2 class="font-display text-xl font-bold text-white mb-2">
                {lesson.title}
              </h2>

              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-4">
                {lesson.description}
              </p>

              <div class="p-3 rounded-2xl bg-white/[0.04] border border-white/[0.08] text-[11px] font-mono text-sky-400 font-semibold mb-6">
                Objective: {lesson.targetZone}
              </div>
            </div>

            <div class="flex items-center justify-between gap-3 pt-4 border-t border-white/[0.08]">
              <a
                href={`/learn/${lesson.lectureSlug}`}
                class="text-xs font-medium text-slate-300 hover:text-white transition-colors"
              >
                Read Physics Theory &rarr;
              </a>

              <a
                href={`/play?scenario=${lesson.id}`}
                class="px-4 py-2 rounded-full bg-emerald-bright hover:bg-emerald text-[#05080C] hover:text-white font-bold text-xs transition-colors"
              >
                Load in Studio &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
