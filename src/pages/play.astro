---
import BaseLayout from '../layouts/BaseLayout.astro';
import { GameShell } from '../components/game/GameShell';
---

<BaseLayout
  title="Play Simulator — CueCraft"
  description="Interactive 2D/3D snooker table simulator with millimeter spin selection, shot power control, and deterministic physics."
  noFooter={true}
>
  <div class="w-full flex-1 min-h-0 h-full overflow-hidden flex flex-col">
    <GameShell client:load />
  </div>
</BaseLayout>
