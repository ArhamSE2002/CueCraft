---
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
>
  <defs>
    <linearGradient id="cc-felt" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#146542" />
      <stop offset="100%" stop-color="#052115" />
    </linearGradient>
    <linearGradient id="cc-gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F5D37E" />
      <stop offset="100%" stop-color="#B88E35" />
    </linearGradient>
  </defs>
  <rect x="2" y="2" width="60" height="60" rx="15" fill="#070A0F" stroke="url(#cc-gold)" stroke-width="2.2" />
  <polygon
    points="16,9 48,9 55,16 55,48 48,55 16,55 9,48 9,16"
    fill="url(#cc-felt)"
    stroke="rgba(226,184,87,0.35)"
    stroke-width="1"
  />
  <circle cx="49" cy="15" r="4.5" fill="#040608" stroke="#E2B857" stroke-width="1.2" />
  <line x1="25" y1="39" x2="44" y2="20" stroke="#2DD4BF" stroke-width="2" stroke-dasharray="3 2.5" stroke-linecap="round" />
  <circle cx="38" cy="26" r="5.5" fill="#E11D48" />
  <circle cx="36.3" cy="24.3" r="1.6" fill="#FDA4AF" />
  <line x1="11" y1="53" x2="21" y2="43" stroke="#E2B857" stroke-width="3.6" stroke-linecap="round" />
  <line x1="19.5" y1="44.5" x2="22" y2="42" stroke="#2DD4BF" stroke-width="3" stroke-linecap="round" />
  <circle cx="25" cy="39" r="6.5" fill="#FAF7F0" stroke="#E2B857" stroke-width="1" />
  <circle cx="23" cy="37" r="2" fill="#FFFFFF" />
</svg>
