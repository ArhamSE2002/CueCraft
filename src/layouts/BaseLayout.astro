---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import CueCraftLogo from '../components/brand/CueCraftLogo.astro';
import { AccountControl } from '../components/auth/AccountControl';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noFooter?: boolean;
  darkScene?: boolean;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  canonical = Astro.url.href,
  image = '/og-image.png',
  noFooter = false,
  darkScene = true,
} = Astro.props;

const pageTitle = title === siteConfig.name ? `${siteConfig.name} — ${siteConfig.tagline}` : `${title} | ${siteConfig.name}`;
const currentPath = Astro.url.pathname;
const isSimulator = noFooter;
const useDarkChrome = isSimulator || darkScene;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Metadata -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="keywords" content={siteConfig.keywords.join(', ')} />
    <meta name="author" content={siteConfig.author} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteConfig.name} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Modern Fonts: Space Grotesk + DM Sans + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class={isSimulator
    ? 'min-h-screen overflow-y-auto lg:h-screen lg:max-h-screen lg:overflow-hidden flex flex-col bg-arena-bg text-arena-text antialiased'
    : darkScene
      ? 'min-h-screen flex flex-col bg-[#05080C] text-white antialiased'
      : 'min-h-screen flex flex-col bg-studio-bg text-studio-ink antialiased'}>

    {/* Global Top Navigation Bar (Adaptive per route mode) */}
    <header class={`sticky top-0 z-50 w-full backdrop-blur-xl transition-colors ${
      isSimulator
        ? 'h-12 bg-arena-bg/95 border-b border-arena-border text-arena-text'
        : darkScene
          ? 'h-16 bg-[#05080C]/70 border-b border-white/[0.08] text-white'
          : 'h-16 bg-studio-bg/85 border-b border-studio-border text-studio-ink'
    }`}>
      <div class={`max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between ${
        isSimulator ? 'h-12' : 'h-16'
      }`}>
        <a href="/" class="flex items-center gap-2.5 group">
          <CueCraftLogo size={isSimulator ? 28 : 34} class="transition-transform duration-200 group-hover:scale-105 shrink-0" />
          <div class="flex flex-col">
            <span class="font-display text-base sm:text-lg font-bold tracking-tight leading-none">
              {siteConfig.name}
            </span>
            <span class={`text-[9px] font-mono tracking-[0.18em] uppercase mt-0.5 ${
              useDarkChrome ? 'text-emerald-bright' : 'text-emerald font-semibold'
            }`}>
              Cue Physics Studio
            </span>
          </div>
        </a>

        {/* Desktop Nav Pills */}
        <nav class={`hidden md:flex items-center gap-1 rounded-full px-1.5 py-1 text-xs font-medium border ${
          useDarkChrome
            ? 'bg-white/[0.05] border-white/[0.1]'
            : 'bg-studio-paper border-studio-border shadow-sm'
        }`}>
          {siteConfig.navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class={`px-3.5 py-1.5 rounded-full transition-all ${
                  isActive
                    ? useDarkChrome
                      ? 'bg-emerald-bright text-arena-bg font-bold'
                      : 'bg-studio-ink text-white font-semibold'
                    : useDarkChrome
                      ? 'text-slate-300 hover:text-white'
                      : 'text-studio-sub hover:text-studio-ink'
                }`}
              >
                {link.title}
              </a>
            );
          })}
        </nav>

        {/* Primary CTA + Persistent Player Profile / Streak */}
        <div class="flex items-center gap-2 sm:gap-2.5">
          <AccountControl client:load />
          {!isSimulator ? (
            <a
              href="/play"
              class={`px-3.5 sm:px-4 py-1.5 sm:py-2 rounded-full font-semibold text-xs tracking-wide transition-all active:scale-95 flex items-center gap-1.5 ${
                useDarkChrome
                  ? 'bg-emerald-bright hover:bg-emerald text-arena-bg hover:text-white font-bold shadow-brass-glow'
                  : 'bg-emerald hover:bg-emerald-dark text-white shadow-sm hover:shadow-md'
              }`}
            >
              <span>Launch Simulator</span>
              <span>&rarr;</span>
            </a>
          ) : (
            <a
              href="/learn"
              class="px-3.5 py-1.5 rounded-full bg-arena-panel hover:bg-arena-elevated border border-arena-border text-arena-text font-medium text-xs transition-colors"
            >
              Lectures &rarr;
            </a>
          )}
        </div>
      </div>

      {/* Mobile Compact Navigation Strip (non-simulator routes) */}
      {!isSimulator && (
        <nav class={`md:hidden flex items-center gap-1.5 overflow-x-auto px-4 py-2 border-t text-[11px] font-medium ${
          useDarkChrome
            ? 'border-white/[0.06] bg-[#05080C]/90'
            : 'border-studio-border bg-studio-paper/90'
        }`}>
          {siteConfig.navLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                class={`shrink-0 px-3 py-1 rounded-full transition-colors ${
                  isActive
                    ? useDarkChrome
                      ? 'bg-emerald-bright text-arena-bg font-bold'
                      : 'bg-studio-ink text-white font-semibold'
                    : useDarkChrome
                      ? 'bg-white/[0.04] text-slate-300'
                      : 'text-studio-sub'
                }`}
              >
                {link.title}
              </a>
            );
          })}
        </nav>
      )}
    </header>

    {/* Page Slot */}
    <main class={isSimulator ? 'flex-1 min-h-0 lg:overflow-hidden flex flex-col' : 'flex-1 relative z-10'}>
      <slot />
    </main>

    {/* Clean Modern Editorial Footer */}
    {!noFooter && (
      <footer class={`relative z-20 w-full border-t ${
        darkScene
          ? 'bg-[#06090D] border-white/[0.08] text-slate-200'
          : 'bg-studio-paper border-studio-border text-studio-ink'
      }`}>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-10">
            <div class="md:col-span-2 flex flex-col gap-3">
              <div class="flex items-center gap-2.5">
                <CueCraftLogo size={30} />
                <span class={`font-display text-lg font-bold tracking-tight ${darkScene ? 'text-white' : 'text-studio-ink'}`}>
                  {siteConfig.name}
                </span>
              </div>
              <p class={`text-xs leading-relaxed max-w-md ${darkScene ? 'text-slate-400' : 'text-studio-sub'}`}>
                Engineering-grade cue sports simulator built for learning ballistics, spin mechanics, cushion geometry, and multi-discipline table strategy across Snooker, 9-Ball, and 8-Ball.
              </p>
              <div class="flex flex-wrap items-center gap-2 mt-1 text-[11px] font-mono text-emerald-bright font-semibold">
                <span>240 Hz Rigid-Body Physics</span>
                <span>&bull;</span>
                <span>2D + 3D Sync</span>
                <span>&bull;</span>
                <span>Zero Install</span>
              </div>
            </div>

            <div class="flex flex-col gap-2.5">
              <span class={`text-xs font-display font-bold uppercase tracking-wider ${darkScene ? 'text-white' : 'text-studio-ink'}`}>
                Simulator
              </span>
              <a href="/play" class={`text-xs transition-colors ${darkScene ? 'text-slate-400 hover:text-emerald-bright' : 'text-studio-sub hover:text-emerald'}`}>
                Practice Lab
              </a>
              <a href="/play?game=snooker" class={`text-xs transition-colors ${darkScene ? 'text-slate-400 hover:text-emerald-bright' : 'text-studio-sub hover:text-emerald'}`}>
                12ft Snooker
              </a>
              <a href="/play?game=9ball" class={`text-xs transition-colors ${darkScene ? 'text-slate-400 hover:text-emerald-bright' : 'text-studio-sub hover:text-emerald'}`}>
                9-Ball Pro Rotation
              </a>
              <a href="/play?game=8ball" class={`text-xs transition-colors ${darkScene ? 'text-slate-400 hover:text-emerald-bright' : 'text-studio-sub hover:text-emerald'}`}>
                American 8-Ball
              </a>
            </div>

            <div class="flex flex-col gap-2.5">
              <span class={`text-xs font-display font-bold uppercase tracking-wider ${darkScene ? 'text-white' : 'text-studio-ink'}`}>
                Curriculum
              </span>
              <a href="/learn/cue-ball-control" class={`text-xs transition-colors ${darkScene ? 'text-slate-400 hover:text-emerald-bright' : 'text-studio-sub hover:text-emerald'}`}>
                Stun &amp; Cue Control
              </a>
              <a href="/learn/topspin-and-backspin" class={`text-xs transition-colors ${darkScene ? 'text-slate-400 hover:text-emerald-bright' : 'text-studio-sub hover:text-emerald'}`}>
                Draw &amp; Follow Slip
              </a>
              <a href="/learn/side-spin-ballistics" class={`text-xs transition-colors ${darkScene ? 'text-slate-400 hover:text-emerald-bright' : 'text-studio-sub hover:text-emerald'}`}>
                Running &amp; Check Side
              </a>
              <a href="/learn/cushion-rebounds" class={`text-xs transition-colors ${darkScene ? 'text-slate-400 hover:text-emerald-bright' : 'text-studio-sub hover:text-emerald'}`}>
                Cushion Restitution
              </a>
            </div>
          </div>

          <div class={`pt-6 border-t flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono ${darkScene ? 'border-white/[0.08] text-slate-500' : 'border-studio-border text-studio-faint'}`}>
            <div>&copy; {new Date().getFullYear()} {siteConfig.name}</div>
            <div class="flex items-center gap-5">
              <a href="/about" class="hover:text-emerald-bright transition-colors">Architecture</a>
              <a href="/learn" class="hover:text-emerald-bright transition-colors">Lectures</a>
              <a href="/lessons" class="hover:text-emerald-bright transition-colors">Drills</a>
              <a href="/play" class="text-emerald-bright font-bold hover:underline transition-colors">Open Table</a>
            </div>
          </div>
        </div>
      </footer>
    )}
  </body>
</html>
